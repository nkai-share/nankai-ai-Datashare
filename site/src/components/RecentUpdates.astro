---
import ResourceCard from './ResourceCard.astro';
import type { Resource } from '../types';
const { resources } = Astro.props as { resources: Resource[] };
---
<div class="recent-grid">{resources.slice(0, 6).map((resource) => <ResourceCard resource={resource} />)}</div>
<style>
  .recent-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 26px; }
  @media (max-width: 900px) { .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .recent-grid { grid-template-columns: 1fr; } }
</style>
